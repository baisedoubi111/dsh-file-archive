{
  "name": "dsh-file-archive",
  "version": "0.1.0",
  "type": "module",
  "description": "Sidebar file manager for DSH workspaces — browse, preview, move (cross-drive) and recycle-bin delete of the files the agent produced.",
  "license": "MIT",
  "author": "dsh-file-archive contributors",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "file-manager",
    "workspace",
    "zip",
    "recycle-bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baisedoubi111/dsh-file-archive.git"
  },
  "homepage": "https://github.com/baisedoubi111/dsh-file-archive#readme",
  "bugs": {
    "url": "https://github.com/baisedoubi111/dsh-file-archive/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "guards.js",
    "zip.js",
    "client.js",
    "cordis.patch.yml",
    "SAFETY.md",
    "docs"
  ]
}
